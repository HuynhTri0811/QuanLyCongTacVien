<Window x:Class="QuanLyCongTacVien.ContractDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý hợp đồng" Height="700" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Header Info -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Ribbon-like Toolbar -->
        <Border Grid.Row="0" Background="#F0F5FF" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="5">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="5,0">
                    <Button x:Name="btnSave" Width="50" Height="50" Click="BtnSave_Click">
                        <StackPanel>
                            <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lưu" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Save" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>

                <StackPanel Margin="5,0">
                    <Button Width="50" Height="50">
                        <StackPanel>
                            <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hợp lệ" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Edit" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <StackPanel Margin="5,0">
                    <Button x:Name="btnClose" Width="50" Height="50" Click="BtnClose_Click">
                        <StackPanel>
                            <TextBlock Text="❌" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Đóng" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Close" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <StackPanel Margin="5,0">
                    <Button x:Name="btnCopy" Width="50" Height="50" Click="BtnCopyOldContracts_Click">
                        <StackPanel>
                            <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sao chép" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Copy" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Header Information -->
        <Border Grid.Row="1" Background="#E1E9F7" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0" Grid.Column="0" Text="Trường/Công ty:*" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TruongCongTy, Mode=TwoWay}" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Năm học:*" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NamHoc, Mode=TwoWay}" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Niên độ tài chính:*" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NienDoTaiChinh, Mode=TwoWay}" Margin="5"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Số thứ tự:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding STT, Mode=TwoWay}" Margin="5"/>
            </Grid>
        </Border>

        <!-- DataGrid for Details -->
        <GroupBox Grid.Row="2" Header="Danh sách hợp đồng" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="Thêm dòng" Width="100" Height="25" Margin="0,0,5,0" Click="BtnAddRow_Click"/>
                    <Button Content="Xóa dòng" Width="100" Height="25" Margin="0,0,5,0" Click="BtnDeleteRow_Click"/>
                    <Button Content="Xuất Excel" Width="100" Height="25" Click="BtnExportDetails_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dgChiTiet" AutoGenerateColumns="False" CanUserAddRows="False"
                          MouseDoubleClick="dgChiTiet_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số hợp đồng" Binding="{Binding SoHopDong}" Width="150"/>
                        <DataGridTextColumn Header="Ngày ký" Binding="{Binding NgayKy, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Bộ phận" Binding="{Binding BoPhan}" Width="150"/>
                        <DataGridTextColumn Header="Người lao động" Binding="{Binding NguoiLaoDong, Mode=OneWay}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="Mã nhân sự" Binding="{Binding MaNhanSu}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Hết hiệu lực" Binding="{Binding HetHieuLuc}" Width="80"/>
                        <DataGridTextColumn Header="Chức danh" Binding="{Binding ChucDanh}" Width="120"/>
                        <DataGridCheckBoxColumn Header="In lại thỏa thuận" Binding="{Binding InLaiThoaThuan}" Width="100"/>
                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
