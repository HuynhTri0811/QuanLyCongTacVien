<Window x:Class="QuanLyCongTacVien.ContractDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý hợp đồng" Height="700" Width="1200" WindowStartupLocation="CenterScreen"
        Icon="Assets/logo.png">
    <Window.Resources>
        <!-- Reusable Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Capsule Button Style -->
        <Style x:Key="CapsuleButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled Blue Button (Add New) -->
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0F62AC"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Outlined Blue Button (Cancel / Secondary) -->
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#0F62AC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#0F62AC"/>
        </Style>

        <!-- Filled Red Button (Delete) -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#C92A2A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Filled Green Button (Export Excel) -->
        <Style x:Key="ExcelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2B8A3E"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Modern Toolbar Button Style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DFECEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CBE0E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGridRow Style with Left Selection Indicator -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left Indicator Bar -->
                                <Border x:Name="Indicator" Grid.Column="0" Width="4" Background="Transparent" CornerRadius="0"/>
                                
                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Indicator" Property="Background" Value="#0F62AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGridColumnHeader Style -->
        <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EBF1F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                               VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled TextBox with slightly round corners -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGridCell Style (Vertically Centered) -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#2A2A2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="10,0" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header Filter Button Style -->
        <Style x:Key="HeaderFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0DFE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column Header with Filter Style -->
        <Style x:Key="FilterDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EBF1F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10,8,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                   VerticalAlignment="Center"/>
                                
                                <!-- Filter Icon Button on the Right -->
                                <Button Grid.Column="1" x:Name="btnFilter" Click="BtnFilterColumn_Click" Margin="4,0,0,0" Width="18" Height="18"
                                        Style="{StaticResource HeaderFilterButtonStyle}"
                                        Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path x:Name="filterPath" Data="M0,0 L6,0 L6,2 L4,5 L4,8 L2,8 L2,5 L0,2 Z" Fill="#8899A6" 
                                          Width="8" Height="8" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="btnFilter" Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnFilter" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Header Info -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Ribbon-like Toolbar -->
        <Border Grid.Row="0" Background="#F0F4FC" BorderBrush="#E4EDF0" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- StackPanel (Left Column) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Lưu -->
                    <Button x:Name="btnSave" Style="{StaticResource CapsuleButton}" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Hợp lệ -->
                    <Button Style="{StaticResource CapsuleButton}" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="Hợp lệ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Đóng -->
                    <Button x:Name="btnClose" Style="{StaticResource CapsuleButton}" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" Margin="0,0,8,0" Click="BtnClose_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="13" Margin="0,0,6,0" FontWeight="Bold" VerticalAlignment="Center" Foreground="#E11D48"/>
                            <TextBlock Text="Đóng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Sao chép -->
                    <Button x:Name="btnCopy" Style="{StaticResource CapsuleButton}" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" Click="BtnCopyOldContracts_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sao chép" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Statistics Counter (Right Column) -->
                <Border Grid.Column="1" Background="#E6FFFA" BorderBrush="#B2F5EA" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="13" Foreground="#0D9488" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TỔNG SỐ HỢP ĐỒNG: " FontSize="11" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalContracts" Text="0" FontSize="11" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Header Information -->
        <Border Grid.Row="1" Background="#F8FAFC" Padding="20,15" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Trường/Công ty -->
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5,5,15,5" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937">
                    <Run Text="Trường/Công ty:"/><Run Text="*" Foreground="#EF4444"/>
                </TextBlock>
                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Height="34" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏢" FontSize="14" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="#9CA3AF"/>
                        <TextBox Grid.Column="1" Text="{Binding TruongCongTy, Mode=TwoWay}" Style="{x:Null}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="5,0"/>
                    </Grid>
                </Border>

                <!-- Row 1: Năm học và Niên độ tài chính -->
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5,5,15,5" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937">
                    <Run Text="Năm học:"/><Run Text="*" Foreground="#EF4444"/>
                </TextBlock>
                <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Height="34" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NamHoc, Mode=TwoWay}" Style="{x:Null}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0,5,0"/>
                        <TextBlock Grid.Column="1" Text="📅" FontSize="14" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="#9CA3AF"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="25,5,15,5" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937">
                    <Run Text="Niên độ tài chính:"/><Run Text="*" Foreground="#EF4444"/>
                </TextBlock>
                <Border Grid.Row="1" Grid.Column="3" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Height="34" Margin="5">
                    <TextBox Text="{Binding NienDoTaiChinh, Mode=TwoWay}" Style="{x:Null}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                </Border>
                
                <!-- Row 2: Số thứ tự -->
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5,5,15,5" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" Text="Số thứ tự:"/>
                <Border Grid.Row="2" Grid.Column="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Height="34" Margin="5">
                    <TextBox Text="{Binding STT, Mode=TwoWay}" Style="{x:Null}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                </Border>
            </Grid>
        </Border>

        <!-- DataGrid for Details -->
        <GroupBox Grid.Row="2" Header="Danh sách chi tiết hợp đồng" Margin="10,15,10,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="+ Thêm dòng" Style="{StaticResource AddButtonStyle}" Width="120" Margin="0,0,10,0" Click="BtnAddRow_Click"/>
                        <Button Content="🗑️ Xóa dòng" Style="{StaticResource DeleteButtonStyle}" Width="110" Margin="0,0,10,0" Click="BtnDeleteRow_Click"/>
                        <Button Content="📊 Xuất Excel" Style="{StaticResource ExcelButtonStyle}" Width="120" Click="BtnExportDetails_Click"/>
                    </StackPanel>
                    
                    <!-- Right Search Input -->
                    <Border Grid.Column="1" Background="#F4F8FA" BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="15" Height="30" Width="260" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search Icon -->
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#8899A6" VerticalAlignment="Center" Margin="10,0,5,0" IsHitTestVisible="False"/>
                            <!-- TextBox -->
                            <TextBox Grid.Column="1" x:Name="txtSearchContract" Style="{x:Null}" Background="Transparent" BorderThickness="0" 
                                     VerticalContentAlignment="Center" Padding="5,0,10,0" FontSize="13" TextChanged="TxtSearchContract_TextChanged"/>
                            
                            <!-- Placeholder text -->
                            <TextBlock Grid.Column="1" Text="Tìm theo số hợp đồng..." FontSize="13" Foreground="#8899A6" 
                                       VerticalAlignment="Center" Margin="5,0,10,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchContract}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="dgChiTiet" AutoGenerateColumns="False" CanUserAddRows="False"
                          MouseDoubleClick="dgChiTiet_MouseDoubleClick"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          ColumnHeaderStyle="{StaticResource FilterDataGridColumnHeader}"
                          BorderThickness="1" BorderBrush="#EBF1F5" RowHeaderWidth="0" GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#E8ECEF" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số hợp đồng" Binding="{Binding SoHopDong}" SortMemberPath="SoHopDong" Width="150"/>
                        <DataGridTextColumn Header="Ngày ký" Binding="{Binding NgayKy, StringFormat=\{0:dd/MM/yyyy\}}" SortMemberPath="NgayKy" Width="100"/>
                        <DataGridTextColumn Header="Bộ phận" Binding="{Binding BoPhan}" SortMemberPath="BoPhan" Width="150"/>
                        <DataGridTextColumn Header="Người lao động" Binding="{Binding NguoiLaoDong, Mode=OneWay}" IsReadOnly="True" SortMemberPath="NguoiLaoDong" Width="150"/>
                        <DataGridTextColumn Header="Mã nhân sự" Binding="{Binding MaNhanSu}" SortMemberPath="MaNhanSu" Width="90"/>
                        <DataGridCheckBoxColumn Header="Hết hiệu lực" Binding="{Binding HetHieuLuc}" SortMemberPath="HetHieuLuc" Width="90"/>
                        <DataGridTextColumn Header="Chức danh" Binding="{Binding ChucDanh}" SortMemberPath="ChucDanh" Width="120"/>
                        <DataGridCheckBoxColumn Header="In lại thỏa thuận" Binding="{Binding InLaiThoaThuan}" SortMemberPath="InLaiThoaThuan" Width="110"/>
                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat=\{0:dd/MM/yyyy\}}" SortMemberPath="TuNgay" Width="100"/>
                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat=\{0:dd/MM/yyyy\}}" SortMemberPath="DenNgay" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
        
        <!-- Excel-like Column Filter Popup -->
        <Popup x:Name="FilterPopup" StaysOpen="False" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="8" Width="220" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.1" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="150"/>  <!-- List of Checkboxes -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>
                    
                    <!-- Search Box inside Popup -->
                    <TextBox Grid.Row="0" x:Name="txtPopupSearch" Margin="0,0,0,8" Height="28" Padding="5,2"
                             FontSize="12" BorderBrush="#D6E0E6" BorderThickness="1" GotFocus="txtPopupSearch_GotFocus"
                             TextChanged="txtPopupSearch_TextChanged"/>
                    
                    <!-- Values ListBox -->
                    <ListBox Grid.Row="1" x:Name="lstFilterValues" BorderBrush="#E0E6ED" BorderThickness="1" Margin="0,0,0,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="4,2">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                          Content="{Binding ValueText}" 
                                          Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"
                                          VerticalContentAlignment="Center" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Action Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Xóa lọc" Click="BtnClearColumnFilter_Click" Height="26" Margin="0,0,4,0"
                                Style="{StaticResource ModernButton}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontSize="11"/>
                        <Button Grid.Column="1" Content="Đồng ý" Click="BtnApplyColumnFilter_Click" Height="26" Margin="4,0,0,0"
                                Style="{StaticResource ModernButton}" Background="#0F62AC" Foreground="White" BorderThickness="0" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
