<Window x:Class="QuanLyCongTacVien.DetailViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết Cộng tác viên" Height="650" Width="1050" WindowStartupLocation="CenterScreen"
        Icon="Assets/logo.png">
    <Window.Resources>
        <!-- Reusable Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled Blue Button (Save) -->
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0F62AC"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Outlined Blue Button (Close) -->
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#0F62AC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#0F62AC"/>
        </Style>

        <!-- Styled TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="6,6,0,0" Margin="2,0,2,-1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CFD8DC"/>
                                <Setter Property="Foreground" Value="#0F62AC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled TextBox with slightly round corners -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled ComboBox and DatePicker height -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern DataGridRow Style with Left Selection Indicator -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left Indicator Bar -->
                                <Border x:Name="Indicator" Grid.Column="0" Width="4" Background="Transparent" CornerRadius="0"/>
                                
                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Indicator" Property="Background" Value="#0F62AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGridColumnHeader Style -->
        <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EBF1F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                               VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGridCell Style (Vertically Centered) -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#2A2A2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="10,0" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header Filter Button Style -->
        <Style x:Key="HeaderFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0DFE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column Header with Filter Style -->
        <Style x:Key="FilterDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EBF1F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10,8,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                   VerticalAlignment="Center"/>
                                
                                <!-- Filter Icon Button on the Right -->
                                <Button Grid.Column="1" x:Name="btnFilter" Click="BtnFilterColumn_Click" Margin="4,0,0,0" Width="18" Height="18"
                                        Style="{StaticResource HeaderFilterButtonStyle}"
                                        Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path x:Name="filterPath" Data="M0,0 L6,0 L6,2 L4,5 L4,8 L2,8 L2,5 L0,2 Z" Fill="#8899A6" 
                                          Width="8" Height="8" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="btnFilter" Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnFilter" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="10,10,10,5">
            <!-- Sơ yếu lý lịch -->
            <TabItem Header="Sơ yếu lý lịch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="10">
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Mã nhân sự:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding MaNhanSu, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Mã nhân viên:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding MaNhanVien, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Họ:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding Ho, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Tên:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding Ten, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Họ và tên:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding HoVaTen, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Ngày sinh:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <DatePicker SelectedDate="{Binding NgaySinh, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Giới tính:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <ComboBox Text="{Binding GioiTinh, Mode=TwoWay}" IsEditable="True">
                                <ComboBoxItem Content="Nam"/>
                                <ComboBoxItem Content="Nữ"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Số CMND:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding SoCMND, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Ngày cấp:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <DatePicker SelectedDate="{Binding NgayCap, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Nơi cấp:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding NoiCap, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Quốc tịch:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding QuocTich, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Dân tộc:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding DanToc, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Email cá nhân:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding EmailCaNhan, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Điện thoại di động:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding DienThoaiDiDong, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Ngày vào Trường:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <DatePicker SelectedDate="{Binding NgayVaoTruong, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Đơn vị:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding DonVi, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Tình trạng:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding TinhTrang, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="920">
                            <TextBlock Text="Ghi chú:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding GhiChu, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Trình độ chuyên môn -->
            <TabItem Header="Trình độ chuyên môn">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="10">
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Học hàm:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding HocHam, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Học vị:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding HocVi, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Chuyên ngành đào tạo:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding ChuyenNganhDaoTao, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Trường đào tạo:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding TruongDaoTao, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Ngày cấp bằng:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <DatePicker SelectedDate="{Binding NgayCapBang, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Năm tốt nghiệp:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding NamTotNghiep, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Trình độ văn hóa:*" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding TrinhDoVanHoa, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Trình độ tin học:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding TrinhDoTinHoc, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Width="300">
                            <TextBlock Text="Ngoại ngữ chính:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                            <TextBox Text="{Binding NgoaiNguChinh, Mode=TwoWay}" />
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Thông tin lương -->
            <TabItem Header="Thông tin lương">
                <WrapPanel Margin="10">
                    <StackPanel Margin="5" Width="450">
                        <TextBlock Text="Mã số thuế:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <TextBox Text="{Binding MaSoThue, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="5" Width="450">
                        <TextBlock Text="% tính thuế:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <TextBox Text="{Binding PhanTramTinhThue, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="5" Width="450">
                        <TextBlock Text="Cơ quan thuế:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <TextBox Text="{Binding CoQuanThue, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="5" Width="450">
                        <TextBlock Text="Tên Ngân Hàng:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <TextBox Text="{Binding TenNganHang, Mode=TwoWay}" />
                    </StackPanel>                    
                    <StackPanel Margin="5" Width="450">
                        <TextBlock Text="Số tài khoản ngân hàng:" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <TextBox Text="{Binding SoTaiKhoan, Mode=TwoWay}" />
                    </StackPanel>
                </WrapPanel>
            </TabItem>
            
            <!-- Hợp đồng Cộng tác viên -->
            <TabItem Header="Hợp đồng Cộng tác viên">
                <Grid Margin="10">
                    <DataGrid x:Name="dgChiTietHopDong" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              ColumnHeaderStyle="{StaticResource FilterDataGridColumnHeader}"
                              BorderThickness="1" BorderBrush="#EBF1F5" RowHeaderWidth="0" GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#E8ECEF" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số hợp đồng" Binding="{Binding SoHopDong}" SortMemberPath="SoHopDong" Width="150"/>
                            <DataGridTextColumn Header="Ngày ký" Binding="{Binding NgayKy, StringFormat=\{0:dd/MM/yyyy\}}" SortMemberPath="NgayKy" Width="100"/>
                            <DataGridTextColumn Header="Bộ phận" Binding="{Binding BoPhan}" SortMemberPath="BoPhan" Width="150"/>
                            <DataGridTextColumn Header="Người lao động" Binding="{Binding NguoiLaoDong, Mode=OneWay}" SortMemberPath="NguoiLaoDong" Width="150"/>
                            <DataGridTextColumn Header="Mã nhân sự" Binding="{Binding MaNhanSu}" SortMemberPath="MaNhanSu" Width="90"/>
                            <DataGridCheckBoxColumn Header="Hết hiệu lực" Binding="{Binding HetHieuLuc}" SortMemberPath="HetHieuLuc" Width="90"/>
                            <DataGridTextColumn Header="Chức danh" Binding="{Binding ChucDanh}" SortMemberPath="ChucDanh" Width="120"/>
                            <DataGridCheckBoxColumn Header="In lại thỏa thuận" Binding="{Binding InLaiThoaThuan}" SortMemberPath="InLaiThoaThuan" Width="110"/>
                            <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat=\{0:dd/MM/yyyy\}}" SortMemberPath="TuNgay" Width="100"/>
                            <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat=\{0:dd/MM/yyyy\}}" SortMemberPath="DenNgay" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <!-- Số hóa giấy tờ -->
            <TabItem Header="Số hóa giấy tờ">
                <TextBlock Text="Tab Số hóa (Đang phát triển)" Margin="20" Foreground="#666666"/>
            </TabItem>
        </TabControl>

        <!-- Bottom Panel -->
        <Border Grid.Row="1" Background="#F4F8FA" BorderBrush="#E4EDF0" BorderThickness="0,1,0,0" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu" Style="{StaticResource SaveButtonStyle}" Width="100" Height="32" Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button Content="Đóng" Style="{StaticResource CancelButtonStyle}" Width="100" Height="32" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
        
        <!-- Excel-like Column Filter Popup -->
        <Popup x:Name="FilterPopup" StaysOpen="False" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="8" Width="220" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.1" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="150"/>  <!-- List of Checkboxes -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>
                    
                    <!-- Search Box inside Popup -->
                    <TextBox Grid.Row="0" x:Name="txtPopupSearch" Margin="0,0,0,8" Height="28" Padding="5,2"
                             FontSize="12" BorderBrush="#D6E0E6" BorderThickness="1" GotFocus="txtPopupSearch_GotFocus"
                             TextChanged="txtPopupSearch_TextChanged"/>
                    
                    <!-- Values ListBox -->
                    <ListBox Grid.Row="1" x:Name="lstFilterValues" BorderBrush="#E0E6ED" BorderThickness="1" Margin="0,0,0,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="4,2">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                          Content="{Binding ValueText}" 
                                          Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"
                                          VerticalContentAlignment="Center" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Action Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Xóa lọc" Click="BtnClearColumnFilter_Click" Height="26" Margin="0,0,4,0"
                                Style="{StaticResource ModernButton}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontSize="11"/>
                        <Button Grid.Column="1" Content="Đồng ý" Click="BtnApplyColumnFilter_Click" Height="26" Margin="4,0,0,0"
                                Style="{StaticResource ModernButton}" Background="#0F62AC" Foreground="White" BorderThickness="0" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
