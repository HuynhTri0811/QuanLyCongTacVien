<Window x:Class="QuanLyCongTacVien.SelectContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn hợp đồng nguồn để sao chép" Height="450" Width="750" WindowStartupLocation="CenterOwner"
        Icon="Assets/logo.png">
    <Window.Resources>
        <!-- Header Filter Button Style -->
        <Style x:Key="HeaderFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0DFE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column Header with Filter Style -->
        <Style x:Key="FilterDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EBF1F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10,8,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                   VerticalAlignment="Center"/>
                                
                                <!-- Filter Icon Button on the Right -->
                                <Button Grid.Column="1" x:Name="btnFilter" Click="BtnFilterColumn_Click" Margin="4,0,0,0" Width="18" Height="18"
                                        Style="{StaticResource HeaderFilterButtonStyle}"
                                        Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path x:Name="filterPath" Data="M0,0 L6,0 L6,2 L4,5 L4,8 L2,8 L2,5 L0,2 Z" Fill="#8899A6" 
                                          Width="8" Height="8" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="btnFilter" Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnFilter" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Chọn hợp đồng để sao chép" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Vui lòng chọn một đợt quản lý hợp đồng nguồn dưới đây để sao chép tất cả các chi tiết hợp đồng của đợt đó." FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Contracts DataGrid -->
        <DataGrid Grid.Row="1" x:Name="dgHopDongNguon" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" MouseDoubleClick="dgHopDongNguon_MouseDoubleClick" Background="White"
                  ColumnHeaderStyle="{StaticResource FilterDataGridColumnHeader}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trường/Công ty" Binding="{Binding TruongCongTy}" SortMemberPath="TruongCongTy" Width="2.5*"/>
                <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" SortMemberPath="NamHoc" Width="*"/>
                <DataGridTextColumn Header="Niên độ tài chính" Binding="{Binding NienDoTaiChinh}" SortMemberPath="NienDoTaiChinh" Width="*"/>
                <DataGridTextColumn Header="Số thứ tự" Binding="{Binding STT}" SortMemberPath="STT" Width="0.8*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Xác nhận" Width="100" Height="30" Margin="0,0,10,0" Click="BtnConfirm_Click" Background="#2980B9" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Button Content="Hủy bỏ" Width="100" Height="30" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
        
        <!-- Excel-like Column Filter Popup -->
        <Popup x:Name="FilterPopup" StaysOpen="False" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="8" Width="220" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.1" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="150"/>  <!-- List of Checkboxes -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>
                    
                    <!-- Search Box inside Popup -->
                    <TextBox Grid.Row="0" x:Name="txtPopupSearch" Margin="0,0,0,8" Height="28" Padding="5,2"
                             FontSize="12" BorderBrush="#D6E0E6" BorderThickness="1" GotFocus="txtPopupSearch_GotFocus"
                             TextChanged="txtPopupSearch_TextChanged"/>
                    
                    <!-- Values ListBox -->
                    <ListBox Grid.Row="1" x:Name="lstFilterValues" BorderBrush="#E0E6ED" BorderThickness="1" Margin="0,0,0,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="4,2">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                          Content="{Binding ValueText}" 
                                          Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"
                                          VerticalContentAlignment="Center" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Action Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Xóa lọc" Click="BtnClearColumnFilter_Click" Height="26" Margin="0,0,4,0"
                                Style="{x:Null}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontSize="11"/>
                        <Button Grid.Column="1" Content="Đồng ý" Click="BtnApplyColumnFilter_Click" Height="26" Margin="4,0,0,0"
                                Style="{x:Null}" Background="#0F62AC" Foreground="White" BorderThickness="0" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
