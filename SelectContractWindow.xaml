<Window x:Class="QuanLyCongTacVien.SelectContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn hợp đồng nguồn để sao chép" Height="450" Width="750" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Chọn hợp đồng để sao chép" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Vui lòng chọn một đợt quản lý hợp đồng nguồn dưới đây để sao chép tất cả các chi tiết hợp đồng của đợt đó." FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Contracts DataGrid -->
        <DataGrid Grid.Row="1" x:Name="dgHopDongNguon" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" MouseDoubleClick="dgHopDongNguon_MouseDoubleClick" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trường/Công ty" Binding="{Binding TruongCongTy}" Width="2.5*"/>
                <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" Width="*"/>
                <DataGridTextColumn Header="Niên độ tài chính" Binding="{Binding NienDoTaiChinh}" Width="*"/>
                <DataGridTextColumn Header="Số thứ tự" Binding="{Binding STT}" Width="0.8*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Xác nhận" Width="100" Height="30" Margin="0,0,10,0" Click="BtnConfirm_Click" Background="#2980B9" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Button Content="Hủy bỏ" Width="100" Height="30" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
