<Window x:Class="QuanLyCongTacVien.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Yes Button Style (Red Capsule) -->
        <Style x:Key="YesButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A61C24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#A61C24" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BC232C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#8F141B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No Button Style (Slate Blue Capsule) -->
        <Style x:Key="NoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4E718F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#4E718F" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5B82A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3D5A72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#700F172A">
        <Border CornerRadius="16" Background="White" Width="380" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.25" ShadowDepth="4"/>
            </Border.Effect>
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock x:Name="txtTitle" Grid.Row="0" Text="Xác nhận xóa" FontSize="18" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Message -->
                <TextBlock x:Name="txtMessage" Grid.Row="1" Text="Bạn có chắc chắn muốn xóa dòng này không?" FontSize="14" Foreground="#475569" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="btnYes" Content="Đồng ý" Width="110" Height="36" Style="{StaticResource YesButtonStyle}" Click="BtnYes_Click" Margin="0,0,15,0"/>
                    <Button x:Name="btnNo" Content="Không" Width="110" Height="36" Style="{StaticResource NoButtonStyle}" Click="BtnNo_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
