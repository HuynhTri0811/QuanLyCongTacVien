<Window x:Class="QuanLyCongTacVien.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông báo"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Width="400" Height="190">
    <Window.Resources>
        <!-- OK Button Style (Light Gray Pill Button) -->
        <Style x:Key="OkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#700F172A">
        <Border CornerRadius="16" Background="White" Width="380" Height="170" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.25" ShadowDepth="4"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Upper Section: Icon + Text -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Container -->
                    <Grid Grid.Column="0" x:Name="gridIcon"/>

                    <!-- Text Container -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock x:Name="txtTitle" Text="Thông báo" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtMessage" Text="Nội dung thông báo..." FontSize="13" Foreground="#475569" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Grid>

                <!-- Lower Section: OK Button -->
                <Button Grid.Row="1" x:Name="btnOk" Content="OK" Height="36" Style="{StaticResource OkButtonStyle}" Click="BtnOk_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
