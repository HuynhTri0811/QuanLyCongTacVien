<Window x:Class="QuanLyCongTacVien.ContractItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết nhân sự hợp đồng" Height="500" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Thông Tin Chi Tiết" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Số hợp đồng:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Item.SoHopDong}" Margin="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày ký:" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Item.NgayKy}" Margin="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Bộ phận:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Item.BoPhan}" Margin="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Người lao động:*" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" 
                              ItemsSource="{Binding DanhSachCongTacVien}" 
                              SelectedValue="{Binding Item.CongTacVienId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="HoVaTen"
                              Margin="5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Mã nhân sự:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Item.MaNhanSu}" Margin="5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Chức danh:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Item.ChucDanh}" Margin="5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Từ ngày:" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding Item.TuNgay}" Margin="5"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Đến ngày:" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker Grid.Row="7" Grid.Column="1" SelectedDate="{Binding Item.DenNgay}" Margin="5"/>

                    <CheckBox Grid.Row="8" Grid.Column="1" Content="Hết hiệu lực" IsChecked="{Binding Item.HetHieuLuc}" Margin="5,10"/>
                    <CheckBox Grid.Row="9" Grid.Column="1" Content="In lại thỏa thuận" IsChecked="{Binding Item.InLaiThoaThuan}" Margin="5,10"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Xuất Word" Width="100" Height="30" Margin="0,0,10,0" Click="BtnExportWord_Click" Background="#2980B9" Foreground="White" BorderThickness="0"/>
            <Button Content="Lưu" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSave_Click" Background="#2ECC71" Foreground="White" BorderThickness="0"/>
            <Button Content="Đóng" Width="100" Height="30" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
